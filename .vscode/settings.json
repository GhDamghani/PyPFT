{
    "files.autoSave": "afterDelay",
    "files.trimTrailingWhitespace": true,
    "editor.renderWhitespace": "trailing",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.wordWrap": "off",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.rulers": [
            88
        ],
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.terminal.launchArgs": [
        "-m",
        "IPython",
        "--no-autoindent"
    ],
    "flake8.importStrategy": "fromEnvironment",
    "flake8.args": [
        "--select=RST"
    ],
    "workbench.editor.empty.hint": "hidden",
    "files.exclude": {
        "**/__pycache__/": true,
        "**/.pytest_cache/": true,
    },
    "search.exclude": {
        "**/__pycache__/": true,
        "**/.pytest_cache/": true,
    },
    "cSpell.ignorePaths": [
        "uv.lock",
        "tests",
        ".vscode/settings.json",
    ],
    "autoDocstring.docstringFormat": "sphinx",
    "autoDocstring.guessTypes": true, // Infer types from PEP 484 hints, defaults, var names
    "autoDocstring.includeExtendedSummary": true, // Add extended summary section
    "autoDocstring.startOnNewLine": true, // New line before summary
    "autoDocstring.generateDocstringOnEnter": true, // Auto-generate on Enter after """
    "autoDocstring.quoteStyle": "\"\"\"",
    "rewrap.wrappingColumn": 88,
    "cSpell.words": [
        "ATOL",
        "autodoc",
        "Baddour",
        "Baddour's",
        "BLAS",
        "classmethod",
        "classmethods",
        "cmap",
        "colorbar's",
        "conftest",
        "dataclass",
        "docstrings",
        "equivariance",
        "fftshift",
        "fignums",
        "figsize",
        "filterwarnings",
        "furo",
        "griddata",
        "Hankel",
        "idft",
        "IFFT",
        "ifftshift",
        "imshow",
        "inited",
        "IPFT",
        "ipynb",
        "isection",
        "isinstance",
        "isort",
        "isubsection",
        "matmul",
        "moveaxis",
        "nbmake",
        "ndarray",
        "ndim",
        "ndims",
        "neighbours",
        "newaxis",
        "numba",
        "numpy",
        "nyquist",
        "Parseval",
        "pypft",
        "pyproject",
        "pytest",
        "reparented",
        "reparenting",
        "RTOL",
        "rtype",
        "scipy",
        "setuptools",
        "shepp",
        "staticmethod",
        "staticmethods",
        "stdlib",
        "suptitle",
        "testpaths",
        "toctree",
        "uncenter",
        "uncentered",
        "unflattens",
        "vmax",
        "vmin",
        "xlabel",
        "ylabel"
    ]
}