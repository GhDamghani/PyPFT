    "Validator: type-validator classmethod (v-type)": {
        "scope": "python, cython",
        "prefix": "v-type",
        "description": "Scaffolds a type-validator @classmethod with RST docstring, isinstance check, and TypeError raise",
        "body": [
            "@classmethod",
            "def type_is_${1:typename}(cls, value: ${1:typename}) -> None:",
            "    \"\"\"",
            "    Type-validator for ${1:typename}.",
            "",
            "    :param value: The value to be validated.",
            "    :type value: ${1:typename}",
            "    :raises TypeError: If the value is not ${2:a} ${1:typename}.",
            "    \"\"\"",
            "    if not isinstance(value, ${1:typename}):",
            "        raise TypeError(",
            "            f\"value must be {${1:typename}.__name__}, got {type(value).__name__}\"",
            "        )",
            "$0"
        ]
    },
    "Validator: value-validator classmethod (v-value)": {
