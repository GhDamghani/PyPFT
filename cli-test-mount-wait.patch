+def _mounted(screen: Screen) -> bool:
+    """Whether ``screen`` and every widget in it have finished mounting.
+
+    ``push_screen`` makes a screen current before it is composed, so right after a
+    step its widgets can be missing, or present without their own children: setting
+    a ``Select`` then raises ``NoMatches`` for its ``#label``. A node's mount event is
+    set only once its children are composed and mounted; Textual 0.39 to 8 share it.
+    """
+    return all(
+        node._mounted_event.is_set() for node in screen.walk_children(with_self=True)
+    )
+
